# MailPilot – lokale Konfiguration
# Kopieren nach .env und nur dort Werte eintragen. .env wird nie eingecheckt.
# Leere Werte gelten als nicht gesetzt.

NODE_ENV=development
DATABASE_URL=postgres://mailpilot:mailpilot@127.0.0.1:55432/mailpilot

# 32 zufällige Bytes als Base64, zum Beispiel: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

HOST=127.0.0.1
PORT=8787
# Öffentliche Adresse der API; OAuth-Rückrufe gehen an <PUBLIC_BASE_URL>/v1/oauth/callback/<provider>
PUBLIC_BASE_URL=http://localhost:8787
APP_URL_SCHEME=mailpilot
SESSION_TTL_DAYS=90

# Entwicklungslogin, nur lokal. In production verweigert die API den Start.
DEV_LOGIN_ENABLED=true
# Nur lokal mit dem GreenMail-Testserver: dessen selbstsigniertes Zertifikat auf 127.0.0.1 erlauben
DEV_IMAP_ALLOW_SELF_SIGNED_LOCALHOST=

# Sign in with Apple: erlaubte Bundle-IDs bzw. Service-IDs, kommagetrennt
APPLE_AUDIENCES=

# Gmail: OAuth-Client aus der Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 / Outlook: App-Registrierung in Microsoft Entra
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# KI-Analyse
# anthropic = echte Analyse, none = aus (Mails bleiben sichtbar ungeprüft),
# fixture = Testdouble mit AI_FIXTURES_FILE (nicht in production)
AI_PROVIDER=none
# Wird nur serverseitig gelesen
ANTHROPIC_API_KEY=
# Modellname ausschließlich hier, zum Beispiel claude-opus-5-5
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=default
# Preise in USD je 1 Mio. Tokens, nur nötig für Modelle ohne hinterlegte Preise
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_FIXTURES_FILE=

# Worker
WORKER_CONCURRENCY=4
MAX_MESSAGES_PER_FETCH=200

# APNs, optional (Token-basiert, .p8-Schlüssel als Datei)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_FILE=
APNS_TOPIC=

LOG_LEVEL=info
